{
  "expo": {
    "name": "CreasPay",
    "slug": "finflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "creaspay",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.olamicreas.finflow",
      "buildNumber": "25",
      "infoPlist": {
        "CFBundleDisplayName": "CreasPay",
        "NSFaceIDUsageDescription": "Use Face ID to securely log in to your CreasPay account.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSRequiresIPhoneOS": true,
        "UIDeviceFamily": [
          1
        ]
      }
    },
    "plugins": [
      "./plugins/withDisableMac.js",
      "expo-font",
      "expo-notifications"
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07070C",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.olamicreas.finflow"
    },
    "extra": {
      "eas": {
        "projectId": "1e5b2cd0-b816-4c72-acaf-e347d25b08c6"
      }
    },
    "owner": "olamicreas"
  }
}
